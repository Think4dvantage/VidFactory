# Env vars for docker-compose.standalone.yml. Copy to .env (gitignored) and fill in real paths
# on the docker host — docker compose loads .env from the project directory automatically.

# Folder on this docker host containing the music library (mp3/m4a/aac/wav/flac/ogg/opus),
# mounted read-only. Folder mode: VidFactory shuffles tracks from here to cover each build's
# needed duration.
VF_MUSIC_HOST=/path/to/music

# Folder on this docker host for produced outputs + archive. VidFactory creates
# fullflights/ summaries/ shorts/ archive/ under it on first write; pre-create them yourself
# to get a clean "ok" health check before the first build runs.
VF_LIBRARY_HOST=/path/to/library

# First-boot bootstrap account (only used once, when the `users` table is empty — no signup UI
# exists, so without these the app has no way to log in). A second user is created afterwards
# with `scripts/create_user.py`, run once against the deployed container.
VF_BOOTSTRAP_USERNAME=
VF_BOOTSTRAP_PASSWORD=

# Base URL of the separate Flightlog service's integration API, e.g. https://fl.lenti.cloud.
# Leave unset to disable the integration entirely.
VF_FLIGHTLOG_URL=
