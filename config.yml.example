# VidFactory configuration. Copy to config.yml and adjust.
# Mount roots can also be overridden by environment variables (shown in [brackets]).

app:
  log_level: INFO            # DEBUG | INFO | WARNING | ERROR

# Local data dir for the SQLite DB + caches. MUST be local (a docker volume) — SQLite WAL mode
# does not work over NFS/SMB. Override with env VF_DATA_DIR. Kept separate from the NAS `archive`.
data_dir: /app/data

ffmpeg:
  # In the Docker image these are on PATH (installed via apt). Override for local runs.
  ffmpeg_path: ffmpeg
  ffprobe_path: ffprobe
  # fontconfig file so drawtext can resolve fonts by name; shipped under resources/.
  resources_dir: resources

# Storage roots. In Docker these are subfolders of the mounted //172.18.10.10/pg share (/data).
# No `videos` root — the NAS is unreachable for the next year; source footage is uploaded
# instead (POST /api/projects/{id}/parts/upload), not browsed.
mounts:
  music: /data/music                # [VF_MUSIC]    music library (read)
  output_fullflights: /data/fullflights # [VF_OUTPUT_FULLFLIGHTS] concatenated full flights (write)
  output_summaries: /data/summaries # [VF_OUTPUT_SUMMARIES] summaries + full-flight-with-music (write)
  output_shorts: /data/shorts       # [VF_OUTPUT_SHORTS]    shorts (write)
  archive: /data/Archive            # [VF_ARCHIVE]  metadata.json + credits (write); NOT the DB

encode:
  video_bitrate: "20M"
  audio_bitrate: "192k"

music:
  music_volume: 0.35                # gain on music before mixing
  original_audio_volume: 1.0        # gain on original/clip audio

shorts:
  clip_duration: 3.0        # length of each sampled flying/hike clip, seconds
  flying_clip_count: 3      # random flying clips per short, spread across the flying time
  hike_clip_count: 2        # Hike & Fly only — clips sampled from the prepended hike segment
  cta_duration: 3.0
  hook_max: 6.0             # cap on the leading highlight clip
  launch_max: 4.0
  landing_max: 4.0
  video_bitrate: "8M"
  audio_bitrate: "128k"
  cta_line1: "for more relaxed Paragliding"
  cta_line2: "Like & Subscribe"

flightlog:
  # [VF_FLIGHTLOG_URL] Base URL of the separate Flightlog service's integration API, e.g.
  # https://fl.lenti.cloud. Each user supplies their own API key on their /account page.
  base_url: null
